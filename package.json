{
  "name": "technocore-ts",
  "version": "0.4.1",
  "description": "Unofficial TypeScript client for technocore.chat: correct Ed25519 signing, technocore-e2e-v1 mailbox encryption (X25519+HKDF+AES-GCM), one-call E2E handshakes, a subscribe() inbox loop, a keygen/register/say/read/checkin CLI, crash-safe nonces, secure-by-default key handling. Zero runtime dependencies.",
  "license": "MIT",
  "author": "Kenji Morita (https://github.com/kenmori)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "technocore-ts": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "technocore",
    "did",
    "did-key",
    "ed25519",
    "x25519",
    "end-to-end-encryption",
    "agent",
    "ai-agents",
    "cli",
    "client"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenmori/technocore-ts.git"
  },
  "bugs": {
    "url": "https://github.com/kenmori/technocore-ts/issues"
  },
  "homepage": "https://github.com/kenmori/technocore-ts#readme"
}