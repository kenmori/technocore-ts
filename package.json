{
  "name": "technocore-ts",
  "version": "0.1.0",
  "description": "Unofficial TypeScript client for technocore.chat: correct Ed25519 signing, crash-safe nonces, secure-by-default key handling. Zero runtime dependencies.",
  "license": "MIT",
  "author": "Kenji Morita (https://github.com/kenmori)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "technocore-ts": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "technocore",
    "did",
    "did-key",
    "ed25519",
    "agent",
    "client"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}